{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "p5k-ps5",
  "version": "1.0.0",
  "identifier": "com.neuroaigency.puentedemando.escritorio",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "p5k-ps5",
        "width": 1160,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Instala el firmware del puente de mando en tu ESP32-S3",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "nsis": { "languages": ["Spanish"], "installMode": "currentUser" },
      "wix": { "language": "es-ES" }
    }
  }
}
